<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="RealtorDesk" Manufacturer="RealtorDesk" Version="$(AppVersion)"
           UpgradeCode="41fd3758-60c3-471c-933b-0a12968038ec" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of RealtorDesk is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="RealtorDeskIcon" SourceFile="$(IconSource)" />
    <Property Id="ARPPRODUCTICON" Value="RealtorDeskIcon" />
    <UIRef Id="RealtorDeskUI" />
    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKCU" Key="Software\RealtorDesk" Name="InstallFolder" Type="raw" />
    </Property>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="RealtorDesk">
          <Directory Id="RuntimeFolder" Name="runtime" />
          <Directory Id="AppFolder" Name="app" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MenuFolder" Name="RealtorDesk">
        <Component Id="AppShortcuts" Guid="*">
          <Shortcut Id="StartMenuShortcut" Name="RealtorDesk"
                    Target="[INSTALLFOLDER]RealtorDesk.exe" WorkingDirectory="INSTALLFOLDER" Icon="RealtorDeskIcon" />
          <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="RealtorDesk"
                    Target="[INSTALLFOLDER]RealtorDesk.exe" WorkingDirectory="INSTALLFOLDER" Icon="RealtorDeskIcon" />
          <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\RealtorDesk" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
          <RegistryValue Root="HKCU" Key="Software\RealtorDesk" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <Feature Id="MainFeature" Title="RealtorDesk" Level="1">
      <Files Directory="RuntimeFolder" Include="$(RuntimeSource)\**" />
      <Files Directory="AppFolder" Include="$(AppSource)\*" />
      <Files Directory="INSTALLFOLDER" Include="$(LauncherSource)\RealtorDesk.exe" />
      <ComponentRef Id="AppShortcuts" />
    </Feature>
  </Package>
</Wix>
